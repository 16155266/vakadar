# SQLite: путь к локальному файлу БД
DATABASE_URL="file:./dev.db"

# Секрет для NextAuth (сгенерируйте: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me"

# OAuth access-токен личной подписки Claude — для классификации Telegram-постов.
# Получить: `ant auth print-credentials --access-token` (см. HHcl/README.md).
# Токен короткоживущий, периодически нужно обновлять.
ANT_ACCESS_TOKEN=""

# Единый пароль на весь сайт (middleware.js) — временная защита, пока проект в разработке.
SITE_PASSWORD="change-me"
